# ==============================================================================
# SIGAP ENVIRONMENT VARIABLES CONFIGURATION (VERCEL READY)
# ==============================================================================

# 1. OPTION A: Vercel Postgres / Neon (Recommended for production on Vercel)
# Automatically provided when connecting Vercel Postgres in Vercel Dashboard
# POSTGRES_URL=postgres://default:xxx@ep-xxx-pooler.us-east-1.postgres.vercel-storage.com:5432/verceldb?sslmode=require
# DATABASE_URL=postgres://default:xxx@ep-xxx-pooler.us-east-1.postgres.vercel-storage.com:5432/verceldb?sslmode=require

# 2. OPTION B: Upstash Redis / Vercel KV
# Automatically provided when adding Upstash Redis / Vercel KV integration
# KV_REST_API_URL=https://xxx.upstash.io
# KV_REST_API_TOKEN=xxx
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxx

# 3. OPTION C: Supabase (Alternative)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 4. Auth & Session Secret
# SESSION_SECRET=sigap-karhutla-sumsel-auth-secret-key-2026
# STAFF_PASSWORD_HASH=$2b$10$2Bxvm5z73AGUU91bcjxZV.6B6MSxCD0ck6yadNEgqRKxgmhcOjNBK

# 5. Cloudflare Turnstile Anti-Spam (Optional)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
